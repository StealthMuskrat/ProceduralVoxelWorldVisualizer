{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "urn:voxelcreator:app-config.schema.json:1",
  "$ref" : "#/$defs/AppMetadata",
  "$defs" : {
    "AppMetadata" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "formatVersion" : {
          "const" : 1
        },
        "controls" : {
          "type" : "object",
          "additionalProperties" : {
            "$ref" : "#/$defs/Control"
          }
        }
      },
      "required" : [ "formatVersion", "controls" ]
    },
    "Control" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "label" : {
          "type" : "string"
        },
        "tooltip" : {
          "type" : "string"
        },
        "description" : {
          "type" : "string"
        }
      },
      "required" : [ "label", "tooltip", "description" ]
    }
  }
}
