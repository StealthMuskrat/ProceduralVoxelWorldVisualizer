{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "urn:voxelcreator:project:2",
  "title" : "Procedural Voxel Creator project format 2",
  "$ref" : "#/$defs/ProjectData",
  "$defs" : {
    "Algorithm" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "key" : {
          "type" : "string",
          "enum" : [ "OPEN_SIMPLEX_2", "PERLIN", "VALUE", "VALUE_CUBIC", "CELLULAR", "WHITE_HASH", "CONSTANT", "GRADIENT_Y", "SPHERE_SDF", "BOX_SDF" ]
        },
        "parameters" : {
          "type" : "object",
          "additionalProperties" : {
            "type" : "number"
          }
        }
      },
      "required" : [ "key", "parameters" ]
    },
    "Binding" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "sourceKind" : {
          "type" : "string",
          "enum" : [ "Constant", "Shared Parameter", "Ambient Value", "Source Result", "Earlier Result", "Noise Generator Reference", "Source Field", "Earlier Field Prefix", "Noise Generator Field" ]
        },
        "type" : {
          "type" : "string"
        },
        "ambientKey" : {
          "type" : [ "string", "null" ]
        },
        "value" : { },
        "parameterUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "itemUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "noiseGeneratorUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "projection" : {
          "type" : "string"
        },
        "slice" : {
          "type" : "number"
        }
      },
      "required" : [ "sourceKind", "type", "ambientKey", "projection", "slice" ]
    },
    "Bookmark" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "name" : {
          "type" : "string"
        },
        "x" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647
        },
        "z" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647
        },
        "y" : {
          "type" : [ "integer", "null" ],
          "minimum" : -2147483648,
          "maximum" : 2147483647
        }
      },
      "required" : [ "name", "x", "z", "uuid" ]
    },
    "Bookmarks" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "noise2D" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Bookmark"
          }
        },
        "noise3D" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Bookmark"
          }
        },
        "world" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Bookmark"
          }
        }
      },
      "required" : [ "noise2D", "noise3D", "world" ]
    },
    "Color" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "r" : {
          "type" : "integer",
          "minimum" : 0,
          "maximum" : 255
        },
        "g" : {
          "type" : "integer",
          "minimum" : 0,
          "maximum" : 255
        },
        "b" : {
          "type" : "integer",
          "minimum" : 0,
          "maximum" : 255
        }
      },
      "required" : [ "r", "g", "b" ]
    },
    "Curve" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "min" : {
          "type" : "number"
        },
        "max" : {
          "type" : "number"
        },
        "displayMin" : {
          "type" : "number"
        },
        "displayMax" : {
          "type" : "number"
        },
        "outsideDomain" : {
          "type" : "string",
          "enum" : [ "CLAMP", "EXTEND", "REPEAT", "MIRROR" ]
        },
        "points" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Point"
          }
        }
      },
      "required" : [ "uuid", "min", "max", "outsideDomain", "points" ]
    },
    "FieldDriver" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "enabled" : {
          "type" : "boolean"
        },
        "noiseGeneratorUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "inputMin" : {
          "type" : "number"
        },
        "inputMax" : {
          "type" : "number"
        },
        "outputMin" : {
          "type" : "number",
          "minimum" : 0,
          "maximum" : 1
        },
        "outputMax" : {
          "type" : "number",
          "minimum" : 0,
          "maximum" : 1
        },
        "mapping" : {
          "type" : "string",
          "enum" : [ "LINEAR", "SMOOTHSTEP" ]
        }
      },
      "required" : [ "enabled", "inputMin", "inputMax", "outputMin", "outputMax", "mapping" ]
    },
    "Folder" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "rootKind" : {
          "type" : "string"
        },
        "parentFolderUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "childOrder" : {
          "type" : "array",
          "items" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          }
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "rootKind", "childOrder", "id", "uuid" ]
    },
    "Gate" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "kind" : {
          "type" : "string",
          "enum" : [ "ALWAYS", "COMPARE", "INTERVAL", "PROBABILITY", "NOT", "AND", "OR" ]
        },
        "comparison" : {
          "type" : "string"
        },
        "threshold" : {
          "type" : "number"
        },
        "max" : {
          "type" : "number"
        },
        "includeMin" : {
          "type" : "boolean"
        },
        "includeMax" : {
          "type" : "boolean"
        },
        "probability" : {
          "type" : "number",
          "minimum" : 0,
          "maximum" : 1
        },
        "seedOffset" : {
          "type" : "integer",
          "minimum" : -9223372036854775808,
          "maximum" : 9223372036854775807
        },
        "noiseGeneratorUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "children" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Gate"
          }
        }
      },
      "required" : [ "kind", "comparison", "threshold", "max", "children" ]
    },
    "Item" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "kind" : {
          "type" : "string"
        },
        "resultType" : {
          "type" : "string",
          "enum" : [ "Scalar", "Boolean", "Vector2", "Vector3", "Coordinates2D", "Coordinates3D" ]
        },
        "enabled" : {
          "type" : "boolean"
        },
        "parameters" : {
          "type" : "object",
          "additionalProperties" : { },
          "properties" : {
            "curve" : {
              "$ref" : "#/$defs/Curve"
            }
          }
        },
        "inputs" : {
          "type" : "object",
          "additionalProperties" : {
            "$ref" : "#/$defs/Binding"
          }
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "resultType", "enabled", "parameters", "inputs", "id", "uuid" ]
    },
    "Layer" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "enabled" : {
          "type" : "boolean"
        },
        "defaults" : {
          "$ref" : "#/$defs/Settings"
        },
        "operations" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Operation"
          }
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "enabled", "defaults", "operations", "id", "uuid" ]
    },
    "Membership" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "voxelTypeUuids" : {
          "type" : "array",
          "items" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          }
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "voxelTypeUuids", "id", "uuid" ]
    },
    "Noise" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "dimension" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647,
          "enum" : [ 2, 3 ]
        },
        "parentFolderUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "algorithm" : {
          "$ref" : "#/$defs/Algorithm"
        },
        "seedOffset" : {
          "type" : "integer",
          "minimum" : -9223372036854775808,
          "maximum" : 9223372036854775807
        },
        "coordinateTransforms" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Item"
          }
        },
        "processing" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Item"
          }
        },
        "sharedParameters" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Parameter"
          }
        },
        "pinnedControls" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Pin"
          }
        },
        "outputBinding" : {
          "$ref" : "#/$defs/Binding"
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "dimension", "algorithm", "seedOffset", "coordinateTransforms", "processing", "sharedParameters", "pinnedControls", "outputBinding", "id", "uuid" ]
    },
    "NumericDriver" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "destination" : {
          "type" : "string",
          "enum" : [ "threshold", "baseHeight", "heightScale" ]
        },
        "combination" : {
          "type" : "string",
          "enum" : [ "REPLACE", "ADD", "MULTIPLY" ]
        },
        "enabled" : {
          "type" : "boolean"
        },
        "noiseGeneratorUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "inputMin" : {
          "type" : "number"
        },
        "inputMax" : {
          "type" : "number"
        },
        "outputMin" : {
          "type" : "number"
        },
        "outputMax" : {
          "type" : "number"
        },
        "mapping" : {
          "type" : "string",
          "enum" : [ "LINEAR", "SMOOTHSTEP" ]
        }
      },
      "required" : [ "destination", "combination", "enabled", "inputMin", "inputMax", "outputMin", "outputMax", "mapping" ]
    },
    "Operation" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "enabled" : {
          "type" : "boolean"
        },
        "noiseGeneratorUuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "interpretation" : {
          "type" : "string",
          "enum" : [ "HEIGHT_BELOW", "HEIGHT_ABOVE", "HEIGHT_BOUNDARY", "SELECTION", "DENSITY", "TYPE_SELECTION", "ALL" ]
        },
        "overrides" : {
          "type" : "object",
          "additionalProperties" : { }
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "enabled", "interpretation", "overrides", "id", "uuid", "noiseGeneratorUuid" ]
    },
    "Parameter" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "type" : {
          "type" : "string"
        },
        "value" : { },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "type", "id", "uuid" ]
    },
    "Pin" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "targetUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "label" : {
          "type" : "string"
        },
        "group" : {
          "type" : "string"
        }
      },
      "required" : [ "label", "group" ]
    },
    "Point" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "x" : {
          "type" : "number"
        },
        "y" : {
          "type" : "number"
        },
        "inTangent" : {
          "type" : "number"
        },
        "outTangent" : {
          "type" : "number"
        },
        "segmentInterpolation" : {
          "type" : "string",
          "enum" : [ "STEP", "LINEAR", "SMOOTH", "BEZIER" ]
        },
        "handleMode" : {
          "type" : "string",
          "enum" : [ "AUTO", "ALIGNED", "FREE" ]
        }
      },
      "required" : [ "x", "y", "inTangent", "outTangent", "segmentInterpolation", "handleMode", "uuid" ]
    },
    "Predicate" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "kind" : {
          "type" : "string"
        },
        "reference" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "children" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Predicate"
          }
        }
      },
      "required" : [ "kind", "children" ]
    },
    "Project" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "seed" : {
          "type" : "integer",
          "minimum" : -9223372036854775808,
          "maximum" : 9223372036854775807
        },
        "minY" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647
        },
        "maxY" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647
        }
      },
      "required" : [ "seed", "minY", "maxY", "uuid" ]
    },
    "ProjectData" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "formatVersion" : {
          "const" : 2
        },
        "project" : {
          "$ref" : "#/$defs/Project"
        },
        "voxelTypes" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/VoxelType"
          }
        },
        "voxelGroups" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Membership"
          }
        },
        "voxelSets" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Membership"
          }
        },
        "noise2D" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Noise"
          }
        },
        "noise3D" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Noise"
          }
        },
        "worldGenerator" : {
          "$ref" : "#/$defs/World"
        },
        "folders" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Folder"
          }
        },
        "bookmarks" : {
          "$ref" : "#/$defs/Bookmarks"
        }
      },
      "required" : [ "formatVersion", "project", "voxelTypes", "voxelGroups", "voxelSets", "noise2D", "noise3D", "worldGenerator", "folders", "bookmarks" ]
    },
    "SamplingTransform" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "enabled" : {
          "type" : "boolean"
        },
        "kind" : {
          "type" : "string",
          "enum" : [ "TRANSLATE", "SCALE", "ROTATE" ]
        },
        "rotationOrder" : {
          "type" : "string",
          "enum" : [ "XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX" ]
        },
        "x" : {
          "type" : "number"
        },
        "y" : {
          "type" : "number"
        },
        "z" : {
          "type" : "number"
        },
        "pivotX" : {
          "type" : "number"
        },
        "pivotY" : {
          "type" : "number"
        },
        "pivotZ" : {
          "type" : "number"
        }
      },
      "required" : [ "enabled", "kind", "rotationOrder", "x", "y", "z", "pivotX", "pivotY", "pivotZ" ]
    },
    "Settings" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "baseHeight" : {
          "type" : "number"
        },
        "heightScale" : {
          "type" : "number"
        },
        "threshold" : {
          "type" : "number"
        },
        "strength" : {
          "type" : "number",
          "minimum" : 0,
          "maximum" : 1
        },
        "probability" : {
          "type" : "number",
          "minimum" : 0,
          "maximum" : 1
        },
        "minY" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647
        },
        "maxY" : {
          "type" : "integer",
          "minimum" : -2147483648,
          "maximum" : 2147483647
        },
        "scaleX" : {
          "type" : "number"
        },
        "scaleY" : {
          "type" : "number"
        },
        "scaleZ" : {
          "type" : "number"
        },
        "offsetX" : {
          "type" : "number"
        },
        "offsetY" : {
          "type" : "number"
        },
        "offsetZ" : {
          "type" : "number"
        },
        "axisX" : {
          "type" : "string",
          "enum" : [ "X", "Y", "Z", "-X", "-Y", "-Z" ]
        },
        "axisY" : {
          "type" : "string",
          "enum" : [ "X", "Y", "Z", "-X", "-Y", "-Z" ]
        },
        "axisZ" : {
          "type" : "string",
          "enum" : [ "X", "Y", "Z", "-X", "-Y", "-Z" ]
        },
        "samplingTransforms" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/SamplingTransform"
          },
          "maxItems" : 64
        },
        "seedOffset" : {
          "type" : "integer",
          "minimum" : -9223372036854775808,
          "maximum" : 9223372036854775807
        },
        "action" : {
          "type" : "string",
          "enum" : [ "SET", "CLEAR", "NO_CHANGE" ]
        },
        "rounding" : {
          "type" : "string"
        },
        "voxelTypeUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        },
        "typeSource" : {
          "type" : "string",
          "enum" : [ "FIXED", "INTERVALS" ]
        },
        "typeIntervals" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/TypeInterval"
          },
          "maxItems" : 256
        },
        "probabilityDriver" : {
          "$ref" : "#/$defs/FieldDriver"
        },
        "strengthDriver" : {
          "$ref" : "#/$defs/FieldDriver"
        },
        "parameterDrivers" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/NumericDriver"
          },
          "maxItems" : 32
        },
        "voxelStatePredicate" : {
          "$ref" : "#/$defs/Predicate"
        },
        "fieldGates" : {
          "$ref" : "#/$defs/Gate"
        }
      },
      "required" : [ "baseHeight", "heightScale", "threshold", "strength", "probability", "minY", "maxY", "scaleX", "scaleY", "scaleZ", "offsetX", "offsetY", "offsetZ", "seedOffset", "action", "rounding", "voxelStatePredicate", "fieldGates" ]
    },
    "TypeInterval" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "min" : {
          "type" : "number"
        },
        "max" : {
          "type" : "number"
        },
        "includeMin" : {
          "type" : "boolean"
        },
        "includeMax" : {
          "type" : "boolean"
        },
        "voxelTypeUuid" : {
          "format" : "uuid",
          "type" : [ "string", "null" ]
        }
      },
      "required" : [ "min", "max", "includeMin", "includeMax" ]
    },
    "VoxelType" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "color" : {
          "$ref" : "#/$defs/Color"
        },
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "id" : {
          "type" : "string"
        }
      },
      "required" : [ "color", "id", "uuid" ]
    },
    "World" : {
      "type" : "object",
      "additionalProperties" : false,
      "properties" : {
        "uuid" : {
          "type" : "string",
          "format" : "uuid"
        },
        "layers" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Layer"
          }
        }
      },
      "required" : [ "layers", "uuid" ]
    }
  }
}
