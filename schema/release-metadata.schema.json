{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxelcreator:release-metadata.schema.json:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "version",
    "releaseUrl"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "releaseUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^#]*$"
    }
  }
}
