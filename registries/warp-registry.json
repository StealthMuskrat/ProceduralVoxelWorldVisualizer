  "components" : [ "displacementX", "displacementY", "displacementZ" ],
  "coordinateStageSources" : [ "Noise Generator Field" ],
  "processingSources" : [ "Source Field", "Earlier Field Prefix", "Noise Generator Field" ],
  "semantics" : "Displace real sampling coordinates. INDEPENDENT octaves sample the original position; PROGRESSIVE octaves sample the accumulated position; SEQUENTIAL additionally updates axes in the selected order. Numeric warpX/Y/Z bindings are stage values; displacementX/Y/Z are resampled fields. No normalization or output clamp.",
  "seedPolicy" : "mix(noiseSeed + rawDoubleBits(seedOffset)); SAME reuses that algorithm seed; INCREMENT uses mix(baseSeed + octave) after octave zero. Referenced fields retain their own canonical seeds."
}
